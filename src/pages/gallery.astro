---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import CategoryGrid from '../components/shared/CategoryGrid.astro';
import ProjectCta from '../components/shared/ProjectCta.astro';

// Generic category labels only (per the safe list) — no locations,
// client names or project results are invented anywhere below.
const projects = [
  {
    title: 'Aluminium Doors',
    description: 'An aluminium door installation for a modern home.',
    image: '/images/placeholders/project-1.svg',
    alt: 'Featured aluminium door project (placeholder image)',
  },
  {
    title: 'Residential Project',
    description: 'A residential renovation combining aluminium doors and windows.',
    image: '/images/placeholders/project-2.svg',
    alt: 'Featured residential project (placeholder image)',
  },
  {
    title: 'Aluminium Windows',
    description: 'A multi-pane aluminium window installation.',
    image: '/images/placeholders/project-3.svg',
    alt: 'Featured aluminium window project (placeholder image)',
  },
  {
    title: 'Contemporary Project',
    description: 'A contemporary aluminium framing project.',
    image: '/images/placeholders/project-4.svg',
    alt: 'Featured contemporary project (placeholder image)',
  },
  {
    title: 'Sliding Door Project',
    description: 'A sliding door configuration for an outdoor-facing opening.',
    image: '/images/placeholders/project-5.svg',
    alt: 'Featured sliding door project (placeholder image)',
  },
  {
    title: 'Custom Project',
    description: 'A custom aluminium configuration for a specific opening.',
    image: '/images/placeholders/project-6.svg',
    alt: 'Featured custom project (placeholder image)',
  },
  {
    title: 'New Build Project',
    description: 'A new-build project combining aluminium doors and windows.',
    image: '/images/placeholders/project-7.svg',
    alt: 'Featured new-build project (placeholder image)',
  },
  {
    title: 'Commercial Project',
    description: 'An aluminium window installation for a commercial development.',
    image: '/images/placeholders/project-8.svg',
    alt: 'Featured commercial project (placeholder image)',
  },
];
---

<BaseLayout
  title="Projects & Gallery"
  description="Browse examples of aluminium door and window project categories. Real project photography will be added here as projects are completed."
  ogImage="/images/placeholders/gallery-hero.svg"
>
  <PageHero
    eyebrow="Our Work"
    title="Projects & Gallery"
    supportingText="This gallery will showcase real aluminium door and window installations as projects are completed. For now, explore the kinds of projects we plan to feature."
    image="/images/placeholders/gallery-hero.svg"
    imageAlt="Project gallery concept (placeholder image)"
  />

  <CategoryGrid
    eyebrow="Selected Work"
    title="Project Gallery"
    note="The images below are placeholders. Real project photography will replace them here as projects are completed."
    categories={projects}
  />

  <ProjectCta
    headline="Like What You See?"
    supportingText="Get in touch and we’ll help you find the right aluminium doors and windows for your home or development."
    buttonLabel="Request a Quote"
    buttonHref="/contact/"
  />
</BaseLayout>
