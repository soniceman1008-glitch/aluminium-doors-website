---
// BenefitsGrid.astro (formerly WhyBenefits) — generic, non-quantified
// benefit / positioning statements. Shared across product pages ("Why
// Aluminium Doors/Windows") and the About page ("Our Approach"). No
// performance numbers, ratings or certifications are ever claimed here.
interface Benefit {
  title: string;
  description: string;
  icon: string;
}

interface Props {
  eyebrow: string;
  title: string;
  benefits: Benefit[];
  variant?: 'alt' | 'plain';
}

const { eyebrow, title, benefits, variant = 'alt' }: Props = Astro.props;
---

<section class={`section why-benefits ${variant === 'alt' ? 'section--alt' : ''}`}>
  <div class="container">
    <div class="section-heading section-heading--center">
      <p class="section-eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
    </div>

    <div class="card-grid why-choose-us__grid">
      {benefits.map((benefit) => (
        <div class="card why-choose-us__card">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={benefit.icon} />
          </svg>
          <h3>{benefit.title}</h3>
          <p>{benefit.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
