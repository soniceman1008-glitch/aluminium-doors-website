---
// Footer.astro
// All contact/business details are explicit, visibly-marked placeholders.
// Do not replace with invented data — real values are supplied later.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-heading">[Company Name Placeholder]</p>
        <p>
          Premium aluminium doors and windows.
          <span class="placeholder-note">(Company description placeholder)</span>
        </p>
      </div>

      <div>
        <p class="footer-heading">Explore</p>
        <ul class="footer-links">
          <li><a href="/aluminium-doors/">Aluminium Doors</a></li>
          <li><a href="/aluminium-windows/">Aluminium Windows</a></li>
          <li><a href="/gallery/">Gallery</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/faq/">FAQ</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-heading">Contact</p>
        <ul class="footer-links">
          <li>
            <span class="placeholder-note">[Phone Number Placeholder]</span>
          </li>
          <li>
            <span class="placeholder-note">[Email Address Placeholder]</span>
          </li>
          <li>
            <span class="placeholder-note">[Business Address Placeholder]</span>
          </li>
        </ul>
      </div>

      <div>
        <p class="footer-heading">Get a Quote</p>
        <a href="/contact/" class="btn btn-outline btn-on-dark">Request a Quote</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} [Company Name Placeholder]. All rights reserved.</p>
      <p class="placeholder-note">
        ABN / business registration details placeholder — to be added once available.
      </p>
    </div>
  </div>
</footer>
