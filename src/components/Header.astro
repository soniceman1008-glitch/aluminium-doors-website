---
// Header.astro
// Responsive site navigation. Desktop shows an inline nav; below 1024px it
// collapses to a toggleable full-screen mobile panel. All business identity
// values below are explicit placeholders — see CLAUDE.md "business data" rule.

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/aluminium-doors/', label: 'Aluminium Doors' },
  { href: '/aluminium-windows/', label: 'Aluminium Windows' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-logo">
      [Company Name Placeholder]
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul class="primary-nav__list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="primary-nav__link"
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="/contact/" class="btn btn-accent">Request a Quote</a>
    </div>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      id="nav-toggle"
    >
      <span class="visually-hidden">Toggle menu</span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="mobile-nav" id="mobile-nav" data-open="false">
  <nav aria-label="Mobile">
    <ul class="mobile-nav__list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav__link"
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mobile-nav__actions">
      <a href="/contact/" class="btn btn-accent btn-block">Request a Quote</a>
    </div>
  </nav>
</div>

<script>
  // Minimal vanilla JS: toggles the mobile navigation panel and keeps
  // aria-expanded in sync. No framework, no dependencies.
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');

  if (toggle && panel) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.setAttribute('data-open', 'false');
    };

    const openMenu = () => {
      toggle.setAttribute('aria-expanded', 'true');
      panel.setAttribute('data-open', 'true');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    // Close the panel when a link inside it is followed.
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Close on Escape for keyboard users.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });

    // If the viewport grows past the mobile breakpoint, reset state.
    const desktopQuery = window.matchMedia('(min-width: 1024px)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>
