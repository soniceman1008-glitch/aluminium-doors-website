---
// Hero.astro — Home page hero.
// Headline/copy are generic and product-category-level only; nothing
// specific to the (currently unknown) business is claimed here.
//
// The right-hand `.hero__media` column (previously a single static
// image) is now an automatic layered product carousel — the active
// door sits centered at full size/opacity, with its neighbors visible
// as smaller, dimmer "peeks" at the left/right edges — see
// src/scripts/hero-carousel.js for the rotation/swipe/pause logic and
// the "Hero Product Carousel" section in global.css for the
// transform/opacity-only transition. Everything else in this component
// (eyebrow, h1, subtitle, grid layout) is unchanged.
//
// The two CTA buttons below keep their original hrefs and .btn-accent
// / .btn-outline classes (only their label text and compact sizing
// changed) — see the "Hero CTA Controls" section in global.css.
//
// Slide content reuses the exact same title/image/alt already used for
// these five door styles in src/pages/aluminium-doors.astro's
// `categories` array — nothing invented here, and aluminium doors are
// this site's flagship product line.
const slides = [
  {
    title: 'Sliding Doors',
    image: '/images/placeholders/door-sliding.svg',
    alt: 'Aluminium sliding door (placeholder image)',
  },
  {
    title: 'Bi-Fold Doors',
    image: '/images/placeholders/door-bifold.svg',
    alt: 'Aluminium bi-fold door (placeholder image)',
  },
  {
    title: 'Hinged Doors',
    image: '/images/placeholders/door-hinged.svg',
    alt: 'Aluminium hinged door (placeholder image)',
  },
  {
    title: 'French Doors',
    image: '/images/placeholders/door-french.svg',
    alt: 'Aluminium French doors (placeholder image)',
  },
  {
    title: 'Custom Aluminium Doors',
    image: '/images/placeholders/door-custom.svg',
    alt: 'Custom aluminium door concept (placeholder image)',
  },
];

// Each slide's position is expressed as its signed circular distance
// from the active slide (0 = active/center, ±1 = the partially-visible
// side peeks, ±2 = further out and fully hidden) — see the
// "Hero Product Carousel" section in global.css for what each position
// looks like, and src/scripts/hero-carousel.js, which recomputes this
// same value for every slide whenever the active one changes so the
// CSS transition animates smoothly between them. Computed here too
// (rather than only in JS) so the very first paint — before JS has run
// at all — already shows the correct layered arrangement instead of a
// flash of stacked/unstyled slides.
const SIDE_POSITIONS = 2;
function initialPosition(index: number) {
  const total = slides.length;
  let diff = ((index % total) + total) % total; // 0..total-1
  if (diff > total / 2) diff -= total;
  if (diff > SIDE_POSITIONS) diff = SIDE_POSITIONS;
  if (diff < -SIDE_POSITIONS) diff = -SIDE_POSITIONS;
  return diff;
}

// Reused verbatim as both the hero's own subtitle AND the floating
// information card's description below (see "Hero Floating Information
// Card") — a single source string so the two can never drift apart,
// rather than retyping the same sentence twice.
const heroSubtitle =
  'Contemporary aluminium doors and windows designed to bring clean architectural lines, natural light and lasting performance to modern homes and developments.';
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="section-eyebrow">[Company Name Placeholder]</p>
      <h1 class="hero__title">Premium Aluminium Doors &amp; Windows</h1>
      <p class="hero__subtitle">{heroSubtitle}</p>
      <div class="hero__actions">
        <a href="/contact/" class="btn btn-accent">Get a Quote</a>
        <a href="#products" class="btn btn-outline">Specifications</a>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero-carousel" data-hero-carousel data-spotlight-level="5">
        <div
          class="hero-carousel__stage"
          data-carousel-stage
          role="group"
          aria-roledescription="carousel"
          aria-label="Featured aluminium door styles"
        >
          <!-- Purely decorative: ambient spotlight glow + faint
               architectural corner accents behind the product frame.
               No content, so it's hidden from assistive tech entirely. -->
          <div class="hero-carousel__backdrop" aria-hidden="true">
            <span class="hero-carousel__spotlight"></span>
            <span class="hero-carousel__corner hero-carousel__corner--tl"></span>
            <span class="hero-carousel__corner hero-carousel__corner--br"></span>
          </div>

          {slides.map((slide, index) => (
            <div
              class="hero-carousel__slide"
              data-carousel-slide
              data-index={index}
              data-pos={initialPosition(index)}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <div class="hero-carousel__frame">
                <img
                  src={slide.image}
                  alt={slide.alt}
                  width="700"
                  height="550"
                  loading={Math.abs(initialPosition(index)) <= 1 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                  class="hero-carousel__image"
                />
                <div class="hero-carousel__caption">
                  <p class="hero-carousel__name">{slide.title}</p>
                </div>
              </div>
            </div>
          ))}

          <!--
            Floating showroom information card (Implementation #9).
            Positioned top-left within the stage, deliberately clear of
            the vertically-centered prev/next arrows below and the
            per-slide caption/title at the very bottom of the frame, so
            it never covers either. Mirrors the currently-active slide's
            own image/title (kept in sync by hero-carousel.js whenever
            the active slide changes — see data-hero-info-image/-title)
            rather than duplicating separate content; the description
            and CTA buttons reuse the hero's own existing subtitle text
            and "Get a Quote" / "Specifications" buttons verbatim.
          -->
          <article class="hero-info-card" data-hero-info-card>
            <div class="hero-info-card__media">
              <img
                src={slides[0].image}
                alt={slides[0].alt}
                width="96"
                height="76"
                loading="eager"
                decoding="async"
                class="hero-info-card__image"
                data-hero-info-image
              />
            </div>
            <div class="hero-info-card__body">
              <h3 class="hero-info-card__title" data-hero-info-title>{slides[0].title}</h3>
              <p class="hero-info-card__desc">{heroSubtitle}</p>
              <div class="hero-info-card__actions">
                <a href="/contact/" class="btn btn-accent">Get a Quote</a>
                <a href="#products" class="btn btn-outline">Specifications</a>
              </div>
            </div>
          </article>

          <!--
            Ambient light control (Implementation #12). Sits top-right of
            the stage — the one corner nothing else in the carousel
            occupies (the info card is top-left, the arrows are
            vertically centered at the edges, and the decorative corner
            accents are top-left/bottom-right — see the sections above).
            Its slider adjusts --spotlight-intensity (a CSS custom
            property, per the brief) on .hero-carousel__spotlight
            purely via opacity — the actual product photo underneath is
            never touched, so there's no destructive image-brightness
            change, just the decorative glow behind it. The level is
            set as a plain data-attribute rather than a JS-driven inline
            style — see the comment in hero-carousel.js for why.
          -->
          <div class="ambient-light" data-ambient-light>
            <button
              type="button"
              class="ambient-light__toggle"
              data-ambient-toggle
              aria-expanded="false"
              aria-controls="ambient-light-panel"
              aria-label="Adjust ambient lighting"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
              </svg>
            </button>

            <div class="ambient-light__panel" id="ambient-light-panel" data-ambient-panel hidden>
              <span class="ambient-light__panel-label" id="ambient-light-label">Ambient Light</span>
              <div class="ambient-light__slider-track">
                <input
                  type="range"
                  class="ambient-light__slider"
                  data-ambient-slider
                  min="0"
                  max="10"
                  step="1"
                  value="5"
                  aria-orientation="vertical"
                  aria-labelledby="ambient-light-label"
                />
              </div>
            </div>
          </div>

          <button
            type="button"
            class="hero-carousel__arrow hero-carousel__arrow--prev"
            data-carousel-prev
            aria-label="Previous door style"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 6l-6 6 6 6" />
            </svg>
          </button>
          <button
            type="button"
            class="hero-carousel__arrow hero-carousel__arrow--next"
            data-carousel-next
            aria-label="Next door style"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 6l6 6-6 6" />
            </svg>
          </button>
        </div>

        <div class="hero-carousel__dots" role="tablist" aria-label="Select door style">
          {slides.map((slide, index) => (
            <button
              type="button"
              class="hero-carousel__dot"
              data-carousel-dot
              data-index={index}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-label={`Show ${slide.title}`}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
