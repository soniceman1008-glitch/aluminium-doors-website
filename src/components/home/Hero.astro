---
// Hero.astro — Home page hero.
// Headline/copy are generic and product-category-level only; nothing
// specific to the (currently unknown) business is claimed here.
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="section-eyebrow">[Company Name Placeholder]</p>
      <h1 class="hero__title">Premium Aluminium Doors &amp; Windows</h1>
      <p class="hero__subtitle">
        Contemporary aluminium doors and windows designed to bring clean
        architectural lines, natural light and lasting performance to
        modern homes and developments.
      </p>
      <div class="hero__actions">
        <a href="/contact/" class="btn btn-accent">Request a Quote</a>
        <a href="#products" class="btn btn-outline">Explore Products</a>
      </div>
    </div>

    <div class="hero__media">
      <img
        src="/images/placeholders/hero.svg"
        alt="Modern aluminium framed doors and windows on a contemporary home (placeholder image)"
        width="960"
        height="1200"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
