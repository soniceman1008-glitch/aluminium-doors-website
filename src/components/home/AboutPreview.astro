---
// AboutPreview.astro — short, easily-replaceable company summary.
// "[Company Name]" is an explicit placeholder, not an invented name.
---

<section class="section about-preview">
  <div class="container about-preview__grid">
    <div class="about-preview__media">
      <img
        src="/images/placeholders/about.svg"
        alt="Aluminium window facade detail (placeholder image)"
        width="960"
        height="720"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="about-preview__content">
      <p class="section-eyebrow">About Us</p>
      <h2 class="section-title">Designed Around Your Home</h2>
      <p>
        [Company Name] designs and supplies aluminium doors and windows for
        homes and developments that call for clean lines and lasting
        quality. This section will be updated with our full company story
        once final business details are confirmed.
      </p>
      <a href="/about/" class="btn btn-outline">About Us</a>
    </div>
  </div>
</section>
