---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import SectionIntro from '../components/shared/SectionIntro.astro';
import CategoryGrid from '../components/shared/CategoryGrid.astro';
import ProductPreview from '../components/product/ProductPreview.astro';
import DesignOptions from '../components/product/DesignOptions.astro';
import BenefitsGrid from '../components/shared/BenefitsGrid.astro';
import ProjectCta from '../components/shared/ProjectCta.astro';

const categories = [
  {
    title: 'Casement Windows',
    description: 'Side-hinged windows that open outward for a full, unobstructed opening.',
    // Real photo (was a placeholder SVG like every other entry here) —
    // free-to-use under the Unsplash License, no attribution required.
    // Photo: "grey metal framed glass window, closed" by Lai Man Nung
    // (https://unsplash.com/photos/grey-metal-framed-glass-window-closed-Dsms8jjMVQo),
    // resized/re-compressed from the original 6048x4024 for web weight.
    // Moved first in this list (was third) so it's the default preview
    // image shown on page load, where the tilt-reveal animation plays.
    image: '/images/products/aluminium-window-casement.jpg',
    alt: 'Close-up of an open aluminium casement window frame',
  },
  {
    title: 'Sliding Windows',
    description: 'Horizontally sliding windows that are simple to operate and space-efficient.',
    image: '/images/placeholders/window-sliding.svg',
    alt: 'Aluminium sliding window (placeholder image)',
  },
  {
    title: 'Awning Windows',
    description: 'Top-hinged windows that open outward, often used for ventilation.',
    image: '/images/placeholders/window-awning.svg',
    alt: 'Aluminium awning window (placeholder image)',
  },
  {
    title: 'Fixed Windows',
    description: 'Non-opening windows designed to maximise natural light and views.',
    image: '/images/placeholders/window-fixed.svg',
    alt: 'Aluminium fixed window (placeholder image)',
  },
  {
    title: 'Custom Windows',
    description: 'Configured to suit non-standard openings or specific project requirements.',
    image: '/images/placeholders/window-custom.svg',
    alt: 'Custom aluminium window concept (placeholder image)',
  },
];

const designOptions = ['Styles', 'Frames', 'Colours', 'Glass Options', 'Hardware', 'Configurations'];

const benefits = [
  {
    title: 'Slim Frame Profiles',
    description: 'Aluminium framing allows for slimmer sightlines, maximising glass area and natural light.',
    icon: 'M4 20 L4 4 L20 4 M4 12 L20 12 M12 4 L12 20',
  },
  {
    title: 'Durable Construction',
    description: 'A naturally durable material suited to everyday residential and commercial use.',
    icon: 'M12 3 L21 8 L21 16 L12 21 L3 16 L3 8 Z M3 8 L12 13 L21 8 M12 13 L12 21',
  },
  {
    title: 'Low Maintenance',
    description: 'Aluminium framing generally requires little upkeep to keep windows looking and functioning well.',
    icon: 'M12 3 L20 6 V11 C20 16 16.5 19.5 12 21 C7.5 19.5 4 16 4 11 V6 Z M8.5 12 L11 14.5 L16 9',
  },
  {
    title: 'Design Flexibility',
    description: 'Available in a range of styles to suit different openings and architectural approaches.',
    icon: 'M4 6 H20 M4 12 H14 M4 18 H20 M17 9 L20 12 L17 15',
  },
  {
    title: 'Supports Natural Light',
    description: 'Slim frames help maximise glazed area, bringing more natural light into a space.',
    icon: 'M12 4 V2 M12 22 V20 M4 12 H2 M22 12 H20 M5.6 5.6 L4.2 4.2 M19.8 19.8 L18.4 18.4 M5.6 18.4 L4.2 19.8 M19.8 4.2 L18.4 5.6 M12 8 A4 4 0 1 0 12 16 A4 4 0 0 0 12 8 Z',
  },
  {
    title: 'Suits Modern & Traditional Homes',
    description: 'Can be styled to suit both contemporary and more traditional home designs.',
    icon: 'M4 11 L12 4 L20 11 M6 10 V20 H18 V10',
  },
];
---

<BaseLayout
  title="Aluminium Windows"
  description="Explore aluminium window options for modern residential and commercial projects — sliding, awning, casement, fixed and custom configurations."
  ogImage="/images/placeholders/windows-hero.svg"
>
  <PageHero
    eyebrow="Aluminium Windows"
    title="Aluminium Windows"
    supportingText="A range of aluminium window solutions designed to bring in natural light while complementing the architectural style of your home or development."
    primaryLabel="Request a Quote"
    primaryHref="/contact/"
    secondaryLabel="Explore Projects"
    secondaryHref="/gallery/"
    image="/images/placeholders/windows-hero.svg"
    imageAlt="Aluminium window facade concept (placeholder image)"
  />

  <SectionIntro
    eyebrow="Introduction"
    title="A Modern Approach to Aluminium Windows"
    paragraph="Aluminium windows are a widely used option in modern residential and commercial construction, valued for their slim frames, design flexibility and ability to support large glazed areas. They offer a clean, contemporary alternative to timber or uPVC framing systems."
  />

  <ProductPreview
    eyebrow="Take a Closer Look"
    title="Preview Window Styles"
    intro="Select a window style below to preview it."
    items={categories}
    showHotspots
    tiltReveal
  />

  <CategoryGrid
    eyebrow="Explore Our Range"
    title="Window Categories"
    note="The categories below reflect common aluminium window types. Final product offerings will be confirmed and updated here."
    categories={categories}
  />

  <DesignOptions
    eyebrow="Configure Your Windows"
    title="Design & Options"
    intro="Aluminium windows can typically be configured across a range of styles, frames and hardware. Specific options for this business will be confirmed and listed here."
    options={designOptions}
  />

  <BenefitsGrid eyebrow="The Benefits" title="Why Aluminium Windows" benefits={benefits} />

  <ProjectCta
    headline="Ready to Explore Aluminium Windows?"
    supportingText="Get in touch and we’ll help you find the right aluminium windows for your home or development."
    buttonLabel="Request a Quote"
    buttonHref="/contact/"
  />
</BaseLayout>
